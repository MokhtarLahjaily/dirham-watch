# Copy to .env and replace every change-me value. .env is git-ignored: never commit it.

# --- Sources -------------------------------------------------------------------------
# Bank Al-Maghrib API key (free): https://apihelpdesk.centralbankofmorocco.ma
# Leave empty to use the keyless Frankfurter mirror of the same BAM transfer rates.
BAM_API_KEY=
# Separate subscription (product "Marché obligataire") for the treasury bond yield curve.
BAM_BOND_API_KEY=
# auto = BAM API when BAM_API_KEY is set, otherwise frankfurter. Or force: bam | frankfurter
FX_SOURCE=auto
# First date loaded by the backfill_history DAG (BAM data starts in 1999).
FX_BACKFILL_START=2010-01-01
# Source for backfills. The BAM API allows 5 calls/minute (one call per business day, so
# ~15 hours from 2010); the mirror serves the same series in about a minute.
FX_BACKFILL_SOURCE=frankfurter
BAM_REQUESTS_PER_MINUTE=5
# Currencies fetched from the mirror: all 30 that Bank Al-Maghrib quotes.
FX_CURRENCIES=AED,AUD,BHD,BRL,CAD,CHF,CNY,DKK,DZD,EGP,EUR,GBP,GIP,INR,JOD,JPY,KWD,LYD,MRO,NOK,OMR,QAR,RUB,SAR,SEK,TND,TRY,USD,XOF,ZAR

# --- Postgres ------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
# Warehouse owner, used by the ingestion and dbt.
WAREHOUSE_PASSWORD=change-me-warehouse
AIRFLOW_DB_PASSWORD=change-me-airflow-db
METABASE_DB_PASSWORD=change-me-metabase-db
# Read-only role Metabase uses to query the staging and marts schemas.
METABASE_READER_PASSWORD=change-me-metabase-reader
# Host port for connecting to the warehouse from your machine (dbt, psql, DBeaver).
WAREHOUSE_HOST_PORT=5433

# --- Airflow (http://localhost:8080) -------------------------------------------------
AIRFLOW_HOST_PORT=8080
# On Linux, set to the output of `id -u` so mounted files keep your ownership.
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
# Any long random string, shared by the Airflow components.
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
# Optional: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Metabase (http://localhost:3000) ------------------------------------------------
METABASE_HOST_PORT=3000
MB_ADMIN_EMAIL=admin@example.com
# Metabase rejects common or short passwords.
MB_ADMIN_PASSWORD=change-me-Dirham-2026
